# =============================================================================
# Income & Expense Tracker — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=expense_tracker
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Backend / FastAPI
# -----------------------------------------------------------------------------
# PostgreSQL (for Docker)
DATABASE_URL=postgresql+asyncpg://app_user:change_me_strong_password@postgres:5432/expense_tracker
DATABASE_URL_SYNC=postgresql+psycopg2://app_user:change_me_strong_password@postgres:5432/expense_tracker

# SQLite (Zero-config for local running without Docker/PostgreSQL):
# DATABASE_URL=sqlite+aiosqlite:///./expense_tracker.db
# DATABASE_URL_SYNC=sqlite:///./expense_tracker.db

SECRET_KEY=change_me_to_a_very_long_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:5173"]

APP_ENV=development
DEBUG=true

# -----------------------------------------------------------------------------
# Frontend / Vite
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost/api/v1
VITE_APP_NAME=FinTrack

# -----------------------------------------------------------------------------
# Demo Credentials (development only)
# -----------------------------------------------------------------------------
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=Demo@12345
